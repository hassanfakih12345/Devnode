---
import BrowserMock from './BrowserMock.astro';
import Icon from './Icon.astro';
import type { Project } from '../data/site';
interface Props { project: Project }
const { project: p } = Astro.props;
---
<article class="project">
  <a href={`/portfolio/${p.slug}/`} class="thumb" aria-label={`${p.name} case study`}>
    <BrowserMock name={p.name} domain={p.domain} accent={p.accent} category={p.category} />
  </a>
  <div class="meta">
    <span>{p.category}</span><span><Icon name="pin" size={14} /> {p.country}</span>
  </div>
  <h3><a href={`/portfolio/${p.slug}/`}>{p.name}</a></h3>
  <p>{p.summary}</p>
  <a class="visit" href={p.url} target="_blank" rel="noopener">Visit {p.domain} <Icon name="external" size={15} /></a>
</article>

<style>
  .project { display: flex; flex-direction: column; }
  .thumb { display: block; transition: transform .2s ease; }
  .thumb:hover { transform: translateY(-4px); }
  .meta { display: flex; gap: 14px; margin: 18px 0 6px; font-size: .82rem; color: var(--muted); font-weight: 500; }
  .meta span { display: inline-flex; align-items: center; gap: 4px; }
  .meta span:first-child { color: var(--blue-dark); }
  h3 { margin-bottom: .35em; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { color: var(--blue-dark); }
  p { color: var(--muted); font-size: .98rem; }
  .visit { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: .95rem; text-decoration: none; margin-top: auto; }
</style>
