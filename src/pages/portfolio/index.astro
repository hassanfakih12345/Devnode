---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { projects } from '../../data/site';
---
<Base title="Portfolio" description="Websites and online stores built by DevNode for clients in DR Congo, Saudi Arabia and beyond.">
  <PageHero eyebrow="Portfolio" title="Work we're proud of" lead="A selection of websites and online stores we have designed, built and launched for our clients." />
  <section class="section">
    <div class="container grid grid-3">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
  <CtaBand title="Your project could be next" />
</Base>
