---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, primaryPhone, waLink } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="container bar">
    <Logo />
    <nav class="nav" id="site-nav" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="btn btn-primary nav-cta" href="/contact/#quote">Get a Quote</a>
    </nav>
    <button class="menu-btn" aria-controls="site-nav" aria-expanded="false" aria-label="Open menu">
      <span class="i-open"><Icon name="menu" /></span>
      <span class="i-close"><Icon name="close" /></span>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const header = document.querySelector('.site-header');
  btn?.addEventListener('click', () => {
    const open = header?.classList.toggle('open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255, 255, 255, .92);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .nav { display: flex; align-items: center; gap: 4px; }
  .nav a:not(.btn) {
    color: var(--text); text-decoration: none; font-weight: 500; font-size: .95rem;
    padding: .5rem .8rem; border-radius: 8px;
  }
  .nav a:not(.btn):hover { color: var(--blue-dark); background: var(--bg-soft); }
  .nav a.active { color: var(--blue-dark); }
  .nav-cta { margin-left: 10px; padding: .6rem 1.1rem; font-size: .95rem; }
  .menu-btn { display: none; background: none; border: 0; color: var(--navy); padding: 8px; cursor: pointer; }
  .i-close { display: none; }

  @media (max-width: 960px) {
    .menu-btn { display: block; }
    .nav {
      display: none; position: absolute; top: 72px; left: 0; right: 0;
      flex-direction: column; align-items: stretch; gap: 2px;
      background: #fff; padding: 12px 20px 20px; border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-lg);
    }
    .nav a:not(.btn) { padding: .8rem .6rem; font-size: 1.05rem; }
    .nav-cta { margin: 10px 0 0; }
    .site-header.open .nav { display: flex; }
    .site-header.open .i-open { display: none; }
    .site-header.open .i-close { display: block; }
  }
</style>
