---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Organization', name: 'DevNode' },
  publisher: { '@type': 'Organization', name: 'DevNode' },
};
---
<Base title={post.data.title} description={post.data.description} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article>
    <header class="page-hero">
      <div class="container">
        <a class="back" href="/blog/">← All articles</a>
        <h1>{post.data.title}</h1>
        <p class="lead">{post.data.description}</p>
        <time datetime={post.data.date.toISOString()}>{fmt} · DevNode</time>
      </div>
    </header>
    <div class="section">
      <div class="container prose"><Content /></div>
    </div>
  </article>
  <CtaBand />
</Base>

<style>
  .back { color: #aebbd2; text-decoration: none; font-size: .95rem; display: inline-block; margin-bottom: 18px; }
  .back:hover { color: #fff; }
  time { color: #8ea0be; font-size: .92rem; }
</style>
