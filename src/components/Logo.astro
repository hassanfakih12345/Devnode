---
import LogoMark from './LogoMark.astro';
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<a href="/" class:list={['logo', { light }]} aria-label="DevNode home">
  <LogoMark size={38} />
  <span class="word"><span class="dev">Dev</span><span class="node">Node</span></span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: .6rem; text-decoration: none; }
  .word { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; letter-spacing: -.02em; line-height: 1; }
  .dev { color: var(--navy); }
  .node { color: var(--blue); }
  .light .dev { color: #fff; }
</style>
