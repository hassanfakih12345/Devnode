---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { phones, waLink } from '../data/site';
---
<div class="wa-float">
  <div class="wa-menu" id="wa-menu" hidden>
    <p>Chat with us on WhatsApp</p>
    {phones.map((p) => (
      <a href={waLink(p.wa)} target="_blank" rel="noopener">
        <WhatsAppIcon size={20} />
        <span><strong>{p.label}</strong><small>{p.display}</small></span>
      </a>
    ))}
  </div>
  <button class="wa-btn" aria-controls="wa-menu" aria-expanded="false" aria-label="Chat on WhatsApp">
    <WhatsAppIcon size={30} />
  </button>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.wa-btn');
  const menu = document.getElementById('wa-menu');
  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = menu!.hidden;
    menu!.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (e) => {
    if (menu && !menu.hidden && !menu.contains(e.target as Node)) {
      menu.hidden = true;
      btn?.setAttribute('aria-expanded', 'false');
    }
  });
</script>

<style>
  .wa-float { position: fixed; right: 20px; bottom: 20px; z-index: 60; display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }
  .wa-btn {
    width: 60px; height: 60px; border-radius: 50%; border: 0; cursor: pointer;
    background: var(--wa); color: #fff; display: grid; place-items: center;
    box-shadow: 0 10px 28px rgba(37, 211, 102, .45);
    transition: transform .15s ease;
  }
  .wa-btn:hover { transform: scale(1.06); }
  .wa-menu { background: #fff; border-radius: 14px; box-shadow: var(--shadow-lg); padding: 14px; width: 250px; border: 1px solid var(--line); }
  .wa-menu p { margin: 0 0 8px; font-size: .85rem; color: var(--muted); font-weight: 500; }
  .wa-menu a { display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: 10px; text-decoration: none; color: var(--text); }
  .wa-menu a:hover { background: var(--bg-soft); }
  .wa-menu a > :global(svg) { color: var(--wa); flex: none; }
  .wa-menu span { display: flex; flex-direction: column; line-height: 1.3; }
  .wa-menu small { color: var(--muted); }
</style>
