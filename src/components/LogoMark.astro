---
interface Props { size?: number; class?: string }
const { size = 40, class: className } = Astro.props;
const id = `g${Math.random().toString(36).slice(2, 8)}`;
---
<svg class={className} width={size} height={size} viewBox="0 0 100 100" role="img" aria-label="DevNode logo">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#22D3EE" />
      <stop offset="1" stop-color="#3B82F6" />
    </linearGradient>
  </defs>
  <rect width="100" height="100" rx="24" fill="#0F1F3A" />
  <g stroke="#fff" stroke-width="3.2" stroke-linecap="round">
    <line x1="38.7" y1="28.5" x2="21.2" y2="49.9" />
    <line x1="21.2" y1="49.9" x2="38.7" y2="71.3" />
    <line x1="61.3" y1="28.5" x2="78.8" y2="49.9" />
    <line x1="78.8" y1="49.9" x2="61.3" y2="71.3" />
  </g>
  <line x1="38.7" y1="71.3" x2="61.3" y2="28.5" stroke={`url(#${id})`} stroke-width="3.6" stroke-linecap="round" />
  <circle cx="38.7" cy="28.5" r="5.7" fill="#fff" />
  <circle cx="61.3" cy="71.3" r="5.7" fill="#fff" />
  <circle cx="61.3" cy="28.5" r="5.9" fill={`url(#${id})`} />
  <circle cx="21.2" cy="49.9" r="6.8" fill={`url(#${id})`} />
  <circle cx="78.8" cy="49.9" r="6.8" fill={`url(#${id})`} />
  <circle cx="38.7" cy="71.3" r="5.9" fill={`url(#${id})`} />
</svg>
