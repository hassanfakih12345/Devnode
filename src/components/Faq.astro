---
import { faqs } from '../data/site';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<div class="faq">
  {faqs.map((f) => (
    <details>
      <summary>{f.q}</summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .faq { display: grid; gap: 12px; max-width: 820px; margin: 0 auto; }
  details { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 0 22px; }
  summary { cursor: pointer; font-weight: 600; color: var(--navy); padding: 18px 0; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-size: 1.4rem; line-height: 1; color: var(--blue); }
  details[open] summary::after { content: '−'; }
  p { color: var(--muted); margin: 0 0 18px; }
</style>
